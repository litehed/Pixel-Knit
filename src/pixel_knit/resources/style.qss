QMainWindow,
QDialog,
QMessageBox {
    background: #faf8f5;
}

QLabel {
    color: #2b2623;
}

QToolTip {
    background: #ffffff;
    color: #2b2623;
    border: 1px solid #ddd5cc;
    padding: 4px 6px;
}

QMenuBar {
    background: #faf8f5;
    color: #2b2623;
    border-bottom: 1px solid #ddd5cc;
}
QMenuBar::item {
    padding: 6px 10px;
    background: transparent;
    border-radius: 4px;
}
QMenuBar::item:selected {
    background: #f1ece6;
}

QMenu {
    background: #ffffff;
    color: #2b2623;
    border: 1px solid #ddd5cc;
    padding: 4px;
}
QMenu::item {
    padding: 6px 24px;
    border-radius: 4px;
}
QMenu::item:selected {
    background: #f3dfe3;
}
QMenu::item:disabled {
    color: #b9b0a8;
}
QMenu::separator {
    height: 1px;
    background: #ddd5cc;
    margin: 4px 8px;
}

QToolBar {
    background: #faf8f5;
    border: none;
    padding: 4px;
    spacing: 4px;
}
QToolBar::separator {
    width: 1px;
    background: #ddd5cc;
    margin: 4px 6px;
}
QToolBar QToolButton {
    padding: 6px 12px;
    border: 1px solid transparent;
    border-radius: 6px;
    background: transparent;
    color: #2b2623;
}
QToolBar QToolButton:hover {
    background: #f1ece6;
}
QToolBar QToolButton:checked {
    background: #f3dfe3;
    border-color: #c2566b;
}
QToolBar QToolButton:disabled {
    color: #b9b0a8;
}

#rowLabel {
    padding: 0 10px;
    color: #8a817a;
    font-weight: 600;
}

QTabWidget::pane {
    border: none;
    border-top: 1px solid #cfc5ba;
    background: #faf8f5;
    top: -1px;
}
QTabBar::tab {
    padding: 7px 6px 7px 16px;
    background: #ebe4db;
    color: #8a817a;
    border: 1px solid #cfc5ba;
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
}
QTabBar::tab:middle,
QTabBar::tab:last {
    margin-left: -1px;
}
QTabBar::tab:first,
QTabBar::tab:only-one {
    padding-right: 16px;  /* Home never has a close button */
}
QTabBar::tab:hover:!selected {
    background: #f1ece5;
    color: #2b2623;
}
QTabBar::tab:selected {
    background: #faf8f5;
    color: #2b2623;
    border-bottom: 1px solid #faf8f5;
}

QToolBar#toolsToolbar {
    border-right: 1px solid #ddd5cc;
}
QToolBar#toolsToolbar QToolButton {
    padding: 6px;
}


#startScreen {
    background: #faf8f5;
}

#startTitle {
    font-size: 36px;
    font-weight: 700;
    color: #2b2623;
}

#startSubtitle {
    font-size: 14px;
    color: #8a817a;
}

#sectionHeading {
    font-size: 11px;
    font-weight: 600;
    color: #8a817a;
}

#emptyState {
    color: #a89f97;
    border: 1px dashed #ddd5cc;
    border-radius: 10px;
}

QPushButton {
    padding: 10px 18px;
    border: 1px solid #ddd5cc;
    border-radius: 8px;
    background: #ffffff;
    color: #2b2623;
    font-size: 14px;
}
QPushButton:hover {
    background: #f1ece6;
}
QPushButton:pressed {
    background: #e8e1da;
}
QPushButton:disabled {
    color: #b9b0a8;
    background: #f6f3ef;
}

QPushButton#primaryButton {
    background: #c2566b;
    border-color: #c2566b;
    color: #ffffff;
    font-weight: 600;
}
QPushButton#primaryButton:hover {
    background: #ad4a5e;
}
QPushButton#primaryButton:pressed {
    background: #9b4154;
}

#recentList {
    background: #ffffff;
    border: 1px solid #ddd5cc;
    border-radius: 10px;
    outline: 0;
}
#recentList::item:hover {
    background: #f6f1ec;
}
#recentList::item:selected {
    background: #f3dfe3;
}

#recentName {
    font-size: 14px;
    font-weight: 600;
    color: #2b2623;
    background: transparent;
}
#recentPath {
    font-size: 11px;
    color: #8a817a;
    background: transparent;
}
#recentThumb {
    background: transparent;
}


QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
}
QScrollBar::handle:vertical {
    background: #ddd5cc;
    border-radius: 3px;
    min-height: 24px;
}
QScrollBar::handle:vertical:hover {
    background: #c9bfb4;
}
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

#palettePanel {
    background: #ffffff;
}

QDockWidget {
    font-size: 11px;
    font-weight: 600;
    color: #8a817a;
}
QDockWidget::title {
    background: #f1ece6;
    padding: 6px 10px;
    border-bottom: 1px solid #ddd5cc;
}

#hexEdit,
QSpinBox {
    padding: 6px 8px;
    border: 1px solid #ddd5cc;
    border-radius: 6px;
    background: #faf8f5;
    color: #2b2623;
}
#hexEdit:focus,
QSpinBox:focus {
    border-color: #c2566b;
}